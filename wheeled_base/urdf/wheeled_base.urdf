  <link name="r_hip_yaw_link">
    <inertial>
      <origin xyz="2.223994e-06 -0.000740055632 -0.03483679166" rpy="0 0 0"/>
      <mass value="0.188"/>
      <inertia ixx="0.000317543934" ixy="-1.4981e-08" ixz="-2.458e-09" iyy="0.000150621818" iyz="-8.652456e-06" izz="0.000218681377"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/r_hip_yaw_link.stl"/></geometry>
