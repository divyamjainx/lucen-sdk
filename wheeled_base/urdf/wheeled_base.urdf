  </joint>
  <joint name="l_hip_yaw_joint" type="revolute">
    <parent link="l_hip_roll_link"/>
    <child link="l_hip_yaw_link"/>
    <origin xyz="-0.02859 0 -0.10916" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.047198" upper="1.047198" effort="14" velocity="33"/>
    <dynamics damping="0.5" friction="0"/>
  </joint>
  <joint name="l_knee_joint" type="revolute">
