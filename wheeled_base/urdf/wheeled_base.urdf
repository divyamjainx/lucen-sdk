<?xml version="1.0"?>
<!-- wheeled_base (wheeled biped). Units: m, kg, rad. X forward, Y left, Z up.
     Zero pose = straight legs; all link frames are parallel to the world frame at the zero pose. Floating base (do not fix base_link).
     Link masses are measured; centres of mass and inertias are computed from the link geometry assuming uniform density.
     Both wheel joints are positive forward. -->
<robot name="wheeled_base">
  <mujoco>
    <compiler meshdir="../meshes/" balanceinertia="true" discardvisual="false" fusestatic="false"/>
  </mujoco>
  <material name="grey"><color rgba="0.30 0.30 0.32 1"/></material>
  <material name="rubber"><color rgba="0.08 0.08 0.08 1"/></material>
  <link name="base_link">
    <inertial>
      <origin xyz="-3.340937e-06 4.382044e-06 0.06033196672" rpy="0 0 0"/>
      <mass value="3.4"/>
      <inertia ixx="0.02376990058" ixy="-5.40617e-07" ixz="-8.5821e-08" iyy="0.0264540363" iyz="1.17175e-07" izz="0.01230035642"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/base_link.stl"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/base_link.stl"/></geometry>
    </collision>
  </link>
  <link name="l_hip_pitch_link">
    <inertial>
      <origin xyz="0.001171727972 0.05717831507 -7.878834e-06" rpy="0 0 0"/>
      <mass value="0.907"/>
      <inertia ixx="0.001008160693" ixy="-6.536528e-06" ixz="-7.508e-09" iyy="0.000678051682" iyz="-3.31661e-07" izz="0.000874556307"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/l_hip_pitch_link.stl"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/l_hip_pitch_link.stl"/></geometry>
    </collision>
  </link>
  <link name="l_hip_roll_link">
    <inertial>
      <origin xyz="-0.02897229124 -5.11276e-07 -0.06563955443" rpy="0 0 0"/>
      <mass value="0.493"/>
      <inertia ixx="0.00061356616" ixy="3.441e-09" ixz="1.2336055e-05" iyy="0.000750591005" iyz="-2.0057e-08" izz="0.000318529903"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/l_hip_roll_link.stl"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/l_hip_roll_link.stl"/></geometry>
    </collision>
  </link>
  <link name="l_hip_yaw_link">
    <inertial>
      <origin xyz="2.224013e-06 -0.001704480951 -0.03483679166" rpy="0 0 0"/>
      <mass value="0.188"/>
      <inertia ixx="0.00031710071" ixy="-1.5384e-08" ixz="-2.458e-09" iyy="0.000150621818" iyz="-3.251714e-06" izz="0.000218238153"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/l_hip_yaw_link.stl"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/l_hip_yaw_link.stl"/></geometry>
    </collision>
  </link>
  <link name="l_knee_link">
    <inertial>
      <origin xyz="-8.2202884e-05 -0.0272891405 -0.07520524843" rpy="0 0 0"/>
      <mass value="1.586"/>
      <inertia ixx="0.01141531574" ixy="1.197261e-06" ixz="9.84639e-06" iyy="0.0116485081" iyz="1.9008531e-05" izz="0.001100259008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/l_knee_link.stl"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/l_knee_link.stl"/></geometry>
