      <geometry><mesh filename="../meshes/r_hip_yaw_link.stl"/></geometry>
    </collision>
  </link>
  <link name="r_knee_link">
    <inertial>
      <origin xyz="-8.2636475e-05 -0.0285796872 -0.07520524819" rpy="0 0 0"/>
      <mass value="1.586"/>
      <inertia ixx="0.01141799945" ixy="1.365507e-06" ixz="9.817062e-06" iyy="0.01164850797" iyz="-0.000175397053" izz="0.00110294261"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/r_knee_link.stl"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/r_knee_link.stl"/></geometry>
    </collision>
  </link>
  <link name="r_wheel_link">
    <inertial>
      <origin xyz="-2.136e-07 -0.007425686463 -3.021e-09" rpy="0 0 0"/>
      <mass value="0.326"/>
      <inertia ixx="0.00085677991" ixy="-2.6e-11" ixz="-1.9e-11" iyy="0.001675328772" iyz="0" izz="0.000856790554"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="../meshes/r_wheel_link.stl"/></geometry>
      <material name="rubber"/>
    </visual>
    <collision>
      <origin xyz="0 -0.0075 0" rpy="0 1.5707963 1.5707963268"/>
      <geometry><cylinder radius="0.085" length="0.028"/></geometry>
    </collision>
  </link>
  <joint name="l_hip_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="l_hip_pitch_link"/>
    <origin xyz="0 0.05074 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.308997" upper="1.308997" effort="36" velocity="50"/>
    <dynamics damping="0.5" friction="0"/>
  </joint>
  <joint name="l_hip_roll_joint" type="revolute">
    <parent link="l_hip_pitch_link"/>
    <child link="l_hip_roll_link"/>
    <origin xyz="0.02859 0.06201 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-1.22173" upper="0.349066" effort="36" velocity="50"/>
