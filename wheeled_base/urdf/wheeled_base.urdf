    <origin xyz="0 -0.00129 -0.17" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="17" velocity="43"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>
  <joint name="r_hip_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="r_hip_pitch_link"/>
    <origin xyz="0 -0.05074 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.308997" upper="1.308997" effort="36" velocity="50"/>
    <dynamics damping="0.5" friction="0"/>
  </joint>
  <joint name="r_hip_roll_joint" type="revolute">
    <parent link="r_hip_pitch_link"/>
    <child link="r_hip_roll_link"/>
    <origin xyz="0.02859 -0.06201 0" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.349066" upper="1.22173" effort="36" velocity="50"/>
    <dynamics damping="0.5" friction="0"/>
  </joint>
  <joint name="r_hip_yaw_joint" type="revolute">
    <parent link="r_hip_roll_link"/>
    <child link="r_hip_yaw_link"/>
    <origin xyz="-0.02859 0 -0.10916" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.047198" upper="1.047198" effort="14" velocity="33"/>
    <dynamics damping="0.5" friction="0"/>
  </joint>
  <joint name="r_knee_joint" type="revolute">
    <parent link="r_hip_yaw_link"/>
