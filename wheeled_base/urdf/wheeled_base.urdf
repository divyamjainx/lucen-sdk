      <geometry><mesh filename="../meshes/r_hip_pitch_link.stl"/></geometry>
    </collision>
  </link>
  <link name="r_hip_roll_link">
    <inertial>
      <origin xyz="-0.02897229124 -5.11276e-07 -0.06563955446" rpy="0 0 0"/>
      <mass value="0.493"/>
      <inertia ixx="0.00061356616" ixy="3.441e-09" ixz="1.2336055e-05" iyy="0.000750591005" iyz="-2.0057e-08" izz="0.000318529903"/>
