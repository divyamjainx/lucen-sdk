    <child link="l_knee_link"/>
    <origin xyz="0 0.02859 -0.06084" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.094395" effort="36" velocity="50"/>
    <dynamics damping="0.5" friction="0"/>
