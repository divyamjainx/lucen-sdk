    <collision>
      <origin xyz="0 0.0075 0" rpy="0 1.5707963 1.5707963268"/>
      <geometry><cylinder radius="0.085" length="0.028"/></geometry>
    </collision>
  </link>
  <link name="r_hip_pitch_link">
    <inertial>
      <origin xyz="0.001171770414 -0.05688369365 -7.878807e-06" rpy="0 0 0"/>
      <mass value="0.907"/>
      <inertia ixx="0.001005499703" ixy="4.046597e-06" ixz="-7.001e-09" iyy="0.000678051593" iyz="3.27245e-07" izz="0.000871895226"/>
