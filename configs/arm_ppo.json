{
  "num_steps_per_env": 256,
  "save_interval": 25,
  "logger": "tensorboard",
  "obs_groups": {
    "policy": [
      "policy"
    ],
    "critic": [
      "policy"
    ]
  },
  "policy": {
    "class_name": "ActorCritic",
    "actor_hidden_dims": [
      64,
      64
    ],
    "critic_hidden_dims": [
      64,
      64
    ],
    "activation": "elu",
    "actor_obs_normalization": true,
    "critic_obs_normalization": true,
    "init_noise_std": 0.3,
    "noise_std_type": "log"
  },
  "algorithm": {
    "class_name": "PPO",
    "num_learning_epochs": 4,
    "num_mini_batches": 4,
    "clip_param": 0.2,
    "gamma": 0.99,
    "lam": 0.95,
    "value_loss_coef": 1.0,
    "entropy_coef": 0.001,
    "learning_rate": 0.0003,
    "max_grad_norm": 1.0,
    "use_clipped_value_loss": true,
    "schedule": "fixed"
  }
}
